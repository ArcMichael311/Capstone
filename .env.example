# Copy this file to ".env" in this same folder (Capstone/.env) and fill in real values.
# .env is git-ignored on purpose - never commit real secrets.
# This file is read by the backend's local run config (.vscode/launch.json -> envFile).

# --- Local smoke test (Dashboard, Create Class, add students) ---
# Leave the SUPABASE_DB_* vars unset to run the backend against a free in-memory
# H2 database locally - no Supabase credentials needed for this.

# --- Only needed once you're ready to test Learning Materials (file uploads) ---
# From Supabase dashboard -> Project Settings -> API:
SUPABASE_URL=
# Project Settings -> API -> "service_role" secret key (NOT the anon key). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=
# Must match the bucket name you create in Supabase Storage.
SUPABASE_STORAGE_BUCKET=learning-materials
MAX_UPLOAD_SIZE_MB=50

# --- Only needed if you want the local backend to hit your real Supabase Postgres
# instead of the local H2 database ---
# SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=
